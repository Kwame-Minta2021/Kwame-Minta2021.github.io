---
import SplitText from './SplitText.astro';
import { site } from '../data/site';
import Icon from './Icon.astro';

const rows: { icon: 'mail' | 'github' | 'linkedin' | 'scholar'; label: string; value: string; href: string; rel?: string }[] = [
  { icon: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { icon: 'github', label: 'GitHub', value: 'Kwame-Minta2021', href: site.github, rel: 'me noopener' },
  { icon: 'linkedin', label: 'LinkedIn', value: 'minta-frederick-kwame', href: site.linkedin, rel: 'me noopener' },
  { icon: 'scholar', label: 'Google Scholar', value: 'Publications', href: site.scholar, rel: 'noopener' },
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container-x reveal">
    <div class="section-head">
      <p class="eyebrow eyebrow-line" data-scramble>07 · Contact</p>
      <SplitText as="h2" id="contact-title" text="Get in touch" />
    </div>
    <p class="max-w-[38rem] text-lg text-muted">
      I would be glad to hear from researchers working on related problems.
    </p>

    <ul class="stagger mt-8 grid max-w-[44rem] gap-3 sm:grid-cols-2">
      {
        rows.map((r, i) => (
          <li style={`--i:${i}`}>
            <a
              href={r.href}
              rel={r.rel}
              class="group flex min-h-16 items-center gap-4 rounded-lg border border-line bg-surface px-4 py-3 text-ink no-underline transition-colors hover:border-accent"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
                <Icon name={r.icon} class="h-[1.15rem] w-[1.15rem]" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold tracking-wide text-muted uppercase">{r.label}</span>
                <span class="block truncate text-[0.98rem] font-medium">{r.value}</span>
              </span>
              <Icon name="arrow" class="h-4 w-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 flex items-center gap-2 text-muted">
      <Icon name="pin" class="h-4 w-4 shrink-0" />
      {site.location}
    </p>
  </div>
</section>
