---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const p = project.data;
const href = `/projects/${project.id}/`;
const meta = [p.period, p.affiliation].filter(Boolean).join(' · ');
---

<article
  class:list={[
    'card-lift group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface hover:border-accent',
    featured && 'md:grid md:grid-cols-[1.15fr_1fr]',
  ]}
>
  <div class:list={['overflow-hidden', featured && 'md:h-full']} style={`view-transition-name: img-${project.id}`}>
    <Image
      src={p.cardImage ?? p.heroImage}
      alt={p.cardAlt ?? p.heroAlt}
      widths={featured ? [480, 800, 1200] : [400, 640, 800]}
      sizes={featured ? '(min-width: 768px) 38rem, 100vw' : '(min-width: 768px) 34rem, 100vw'}
      class:list={[
        'card-img w-full object-cover',
        featured ? 'aspect-[4/3] object-[50%_30%] md:aspect-auto md:h-full md:object-center' : 'aspect-[2/1]',
      ]}
    />
  </div>
  <div class:list={['flex flex-1 flex-col p-5', featured ? 'md:p-8' : 'sm:p-6']}>
    {featured && <p class="eyebrow mb-3">Featured project</p>}
    <h3 class:list={[featured ? 'text-2xl sm:text-3xl' : 'text-xl']} style={`view-transition-name: title-${project.id}`}>
      <a href={href} class="text-ink no-underline after:absolute after:inset-0 after:content-['']">
        {p.title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-muted">{meta}</p>
    <p class="mt-3 text-[0.97rem]">{p.summary}</p>
    {
      featured && p.stats.length > 0 && (
        <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-line py-4">
          {p.stats.map((st) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-0.5 text-sm leading-snug text-muted">{st.label}</dt>
              <dd class="font-serif text-2xl font-semibold text-accent tabular-nums sm:text-3xl">
                {st.prefix}<span data-count={st.value} data-decimals={st.decimals}>{st.value.toFixed(st.decimals)}</span>{st.suffix}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Technologies">
      {p.tags.slice(0, featured ? 8 : 4).map((t) => <li class="tag">{t}</li>)}
    </ul>
    <p class="mt-auto pt-5 text-sm font-medium text-accent" aria-hidden="true">
      <span class="inline-flex items-center gap-1.5 group-hover:underline">
        Read more <span class="card-arrow inline-flex"><Icon name="arrow" /></span>
      </span>
    </p>
  </div>
</article>
