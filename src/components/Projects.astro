---
import SplitText from './SplitText.astro';
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container-x">
    <div class="section-head reveal">
      <p class="eyebrow eyebrow-line" data-scramble>02 · Projects</p>
      <SplitText as="h2" id="projects-title" text="Selected projects" />
    </div>

    <div class="flex flex-col gap-6">
      {
        featured.map((p) => (
          <div class="reveal">
            <ProjectCard project={p} featured />
          </div>
        ))
      }
      <div class="grid gap-6 md:grid-cols-2">
        {
          rest.map((p) => (
            <div class="reveal flex">
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
