---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Page not found | ${site.name}`} description="This page does not exist.">
  <section class="container-x py-24 md:py-32">
    <p class="eyebrow mb-3">404</p>
    <h1 class="text-4xl">This page does not exist.</h1>
    <p class="mt-4 text-lg text-muted">The link may be out of date.</p>
    <p class="mt-8"><a href="/" class="btn btn-primary">Back to the home page</a></p>
  </section>
</Base>
